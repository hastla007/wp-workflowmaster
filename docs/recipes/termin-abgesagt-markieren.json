{
  "format": "workflow-captain/workflow",
  "format_version": 1,
  "name": "Date canceled: tag the date and notify the site operator",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "type": "trigger",
        "event": "pass.occurrence.cancelled"
      },
      {
        "id": "tag",
        "type": "action",
        "action": "workflow.tag.set",
        "config": {
          "tag": "abgesagt"
        }
      },
      {
        "id": "mail",
        "type": "action",
        "action": "notify.admin",
        "config": {
          "subject": "Date {{subject.id}} canceled",
          "message": "{{data.issued_tickets}} issued tickets are affected. Pass Captain informs the guests itself; this notice is in addition.",
          "to": "site_admin"
        }
      },
      {
        "id": "ende",
        "type": "end"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "tag"
      },
      {
        "from": "tag",
        "to": "mail"
      },
      {
        "from": "mail",
        "to": "ende"
      }
    ]
  }
}
